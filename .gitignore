cat << 'EOF' > .gitignore
# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
ENV/
env/
.venv/

# IDE & Editor Files
.vscode/
.idea/
*.swp
*.swo

# Local Vector Database & Runtime Outputs (Optional: keep outputs if you want reviewers to see pre-generated runs, or ignore them if the repo should generate them via python main.py)
# Note: Keeping ./outputs/ in git ensures reviewers immediately see your JSON/Markdown deliverables without running code.
# If you want to exclude local ChromaDB cache to keep the repo lightweight, uncomment below:
# outputs/chroma_db/
EOF